#!/usr/bin/env python3

"""
Bidirectional Keelson NMEA Connector

This script provides bidirectional NMEA connectivity:
1. NMEA Input -> Keelson messages (like the original main script)
2. Keelson messages -> NMEA Output via UDP/TCP/Serial/Multicast

Usage examples:
  # Input only (original behavior)
  socat UDP4-RECV:8500,reuseaddr STDOUT | python3 main_bidirectional --log-level 10 -r rise -e vessel1 -s gps/1 --publish all
  
  # Output only 
  python3 main_bidirectional --log-level 10 -r rise -e vessel1 --output-only --output-udp 192.168.1.100:8501 --nmea-sentences GGA,RMC,VTG
  
  # Bidirectional (input from stdin, output via UDP)
  socat UDP4-RECV:8500,reuseaddr STDOUT | python3 main_bidirectional --log-level 10 -r rise -e vessel1 -s gps/1 --publish all --output-udp 192.168.1.100:8501 --nmea-sentences GGA,RMC
"""

import zenoh
import logging
import warnings
import atexit
import json
import time
import keelson
import asyncio
import signal
import sys
from typing import Optional
from terminal_inputs import terminal_inputs_bidirectional
from nmea_utils import extract_rot_value
from datetime import datetime
from keelson.payloads.Primitives_pb2 import TimestampedBytes, TimestampedInt, TimestampedFloat, TimestampedString, TimestampedTimestamp
from keelson.payloads.foxglove.LocationFix_pb2 import LocationFix
import pynmea2
import pytz

# Import our new modules
from nmea_output_adapter import (
    MultiOutputAdapter, OutputConfig, OutputType,
    create_udp_config, create_tcp_config, create_serial_config, 
    create_multicast_config, create_socat_config
)
from keelson_to_nmea import KeelsonToNmeaConverter, create_subscription_config

# Global variables for cleanup
session = None
args = None
gpgsv_buffer = []
output_adapter = None
keelson_converter = None


async def setup_output_adapters(args) -> MultiOutputAdapter:
    """Setup output adapters based on command line arguments."""
    configs = []
    
    # UDP output
    if hasattr(args, 'output_udp') and args.output_udp:
        for udp_spec in args.output_udp:
            try:
                host, port = udp_spec.split(':')
                configs.append(create_udp_config(host, int(port)))
                logging.info(f"Configured UDP output to {host}:{port}")
            except ValueError:
                logging.error(f"Invalid UDP specification: {udp_spec}")
    
    # TCP output  
    if hasattr(args, 'output_tcp') and args.output_tcp:
        for tcp_spec in args.output_tcp:
            try:
                host, port = tcp_spec.split(':')
                configs.append(create_tcp_config(host, int(port)))
                logging.info(f"Configured TCP output to {host}:{port}")
            except ValueError:
                logging.error(f"Invalid TCP specification: {tcp_spec}")
    
    # Serial output
    if hasattr(args, 'output_serial') and args.output_serial:
        for serial_spec in args.output_serial:
            try:
                parts = serial_spec.split(':')
                device = parts[0]
                baudrate = int(parts[1]) if len(parts) > 1 else 115200
                configs.append(create_serial_config(device, baudrate))
                logging.info(f"Configured Serial output to {device} at {baudrate} baud")
            except (ValueError, IndexError):
                logging.error(f"Invalid Serial specification: {serial_spec}")
    
    # Multicast output
    if hasattr(args, 'output_multicast') and args.output_multicast:
        for mcast_spec in args.output_multicast:
            try:
                group, port = mcast_spec.split(':')
                configs.append(create_multicast_config(group, int(port)))
                logging.info(f"Configured Multicast output to {group}:{port}")
            except ValueError:
                logging.error(f"Invalid Multicast specification: {mcast_spec}")
    
    # SOCAT output
    if hasattr(args, 'output_socat') and args.output_socat:
        for socat_cmd in args.output_socat:
            configs.append(create_socat_config(socat_cmd))
            logging.info(f"Configured SOCAT output: {socat_cmd}")
    
    # Create and start multi-output adapter
    adapter = MultiOutputAdapter(configs)
    if configs:
        await adapter.start()
        logging.info(f"Started {adapter.get_active_adapters()} output adapters")
    
    return adapter


async def setup_keelson_converter(session, args, output_adapter) -> Optional[KeelsonToNmeaConverter]:
    """Setup Keelson to NMEA converter."""
    if not hasattr(args, 'nmea_sentences') or not args.nmea_sentences:
        return None
    
    # Parse NMEA sentences to generate
    nmea_sentences = set()
    for sentence_list in args.nmea_sentences:
        for sentence in sentence_list.split(','):
            nmea_sentences.add(sentence.strip().upper())
    
    if not nmea_sentences:
        return None
    
    # Create subscription config
    source_patterns = getattr(args, 'subscribe_sources', [args.source_id + "/**"])
    update_rate = getattr(args, 'nmea_rate_hz', 1.0)
    talker_id = getattr(args, 'nmea_talker_id', 'GP')
    
    subscription_config = create_subscription_config(
        realm=args.realm,
        entity_id=args.entity_id,
        source_patterns=source_patterns,
        nmea_sentences=nmea_sentences,
        update_rate_hz=update_rate,
        talker_id=talker_id
    )
    
    # Create and start converter
    converter = KeelsonToNmeaConverter(session, subscription_config, output_adapter)
    await converter.start()
    
    logging.info(f"Started Keelson to NMEA converter for sentences: {nmea_sentences}")
    return converter


def signal_handler(signum, frame):
    """Handle shutdown signals."""
    logging.info(f"Received signal {signum}, shutting down...")
    sys.exit(0)


async def cleanup():
    """Cleanup resources on shutdown."""
    global output_adapter, keelson_converter, session
    
    try:
        if keelson_converter:
            await keelson_converter.stop()
        if output_adapter:
            await output_adapter.stop()
        if session:
            session.close()
    except Exception as e:
        logging.error(f"Error during cleanup: {e}")


async def process_nmea_input(args, session):
    """Process NMEA input from stdin (original functionality)."""
    if getattr(args, 'output_only', False):
        return  # Skip input processing if output-only mode
    
    # Setup publishers (from original main script)
    key_exp_pub_raw = keelson.construct_pubsub_key(
        base_path=args.realm,
        entity_id=args.entity_id,
        subject="raw",  
        source_id=args.source_id + "/nmea",
    )
    pub_raw = session.declare_publisher(
        key_exp_pub_raw, congestion_control=zenoh.CongestionControl.DROP
    )
    logging.info(f"Created publisher: {key_exp_pub_raw}")
    
    # Process NMEA input from stdin
    while True:
        try:
            line = sys.stdin.buffer.readline()
            if not line:
                await asyncio.sleep(0.001)
                continue
            
            ingress_timestamp = time.time_ns()

            # Publish RAW message
            if any(topic in args.publish for topic in ("raw", "all")):
                logging.debug("Publish RAW message...")
                payload = TimestampedBytes()
                payload.timestamp.FromNanoseconds(ingress_timestamp)
                payload.value = line
                serialized_payload = payload.SerializeToString()
                envelope = keelson.enclose(serialized_payload)
                pub_raw.put(envelope)
                logging.debug(f"...published on {key_exp_pub_raw}")

            # Process NMEA sentence (similar to original main script)
            nmea_sentence = line.decode("utf-8").strip()
            logging.debug(f"Decoding NMEA message: {nmea_sentence}")
            
            # Clean up corrupted NMEA sentences
            dollar_index = nmea_sentence.rfind('$')
            if dollar_index > 0:
                cleaned_sentence = nmea_sentence[dollar_index:].strip()
                logging.debug(f"Cleaned corrupted sentence: {nmea_sentence} -> {cleaned_sentence}")
                nmea_sentence = cleaned_sentence
            elif not nmea_sentence.startswith('$'):
                logging.debug(f"Skipping non-NMEA sentence: {nmea_sentence}")
                continue
            
            # Process different NMEA sentence types (simplified examples)
            # NOTE: For production use, copy the complete NMEA processing logic from the original main script
            
            # Simple ROT processing example
            if (nmea_sentence.startswith("$GPROT") or nmea_sentence.startswith("$GNROT")) and ("ROT" in args.publish or "all" in args.publish):
                logging.debug(f"Processing NMEA ROT: {nmea_sentence}")
                try:
                    rot_numeric = extract_rot_value(nmea_sentence)
                    if rot_numeric is not None:
                        payload_rot = TimestampedFloat()
                        payload_rot.timestamp.FromNanoseconds(ingress_timestamp)
                        payload_rot.value = rot_numeric
                        serialized_payload = payload_rot.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_rot = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="yaw_rate_degps",
                            source_id=args.source_id + "/nmea/ROT",
                        )
                        session.put(
                            key_expr=key_exp_pub_rot,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"Published ROT data: {rot_numeric}")
                except Exception as e:
                    logging.error(f"Error processing ROT: {e}")
            
            else:
                # Log unhandled sentence types for debugging
                sentence_type = nmea_sentence[:6] if len(nmea_sentence) >= 6 else nmea_sentence
                logging.debug(f"Unhandled NMEA sentence type: {sentence_type}")
            
        except pynmea2.ChecksumError as e:
            logging.warning(f"Skipping NMEA line due to invalid checksum: {e}")
            continue
        except Exception as e:
            logging.error(f"Error parsing NMEA data: {e}")
            continue


async def main():
    """Main function for bidirectional NMEA connector."""
    global session, args, output_adapter, keelson_converter
    
    # Setup signal handlers
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    try:
        # Parse arguments
        args = terminal_inputs_bidirectional()
        
        # Setup logging
        logging.basicConfig(
            format="%(asctime)s %(levelname)s %(name)s :%(lineno)d %(message)s", 
            level=args.log_level
        )
        logging.captureWarnings(True)
        warnings.filterwarnings("once")

        logging.info("Starting Bidirectional Keelson NMEA Connector...")
        
        # Setup Zenoh session
        logging.info("Opening Zenoh session...")
        zenoh.init_log_from_env_or("error")

        conf = zenoh.Config()
        if args.connect is not None:
            conf.insert_json5("connect/endpoints", json.dumps(args.connect))
        
        session = zenoh.open(conf)
        logging.info("Zenoh session opened.")
        
        # Setup output adapters
        output_adapter = await setup_output_adapters(args)
        
        # Setup Keelson to NMEA converter
        keelson_converter = await setup_keelson_converter(session, args, output_adapter)
        
        # Register cleanup on exit
        atexit.register(lambda: asyncio.run(cleanup()))
        
        logging.info("Bidirectional NMEA connector started successfully")
        
        # Process NMEA input if not in output-only mode
        if not getattr(args, 'output_only', False):
            logging.info("Processing NMEA input from stdin...")
            await process_nmea_input(args, session)
        else:
            logging.info("Running in output-only mode...")
            # Keep the program running to process Keelson messages
            while True:
                await asyncio.sleep(1.0)
        
    except KeyboardInterrupt:
        logging.info("Received keyboard interrupt, shutting down...")
    except Exception as e:
        logging.error(f"Error in main: {e}")
        raise
    finally:
        await cleanup()


if __name__ == "__main__":
    asyncio.run(main())