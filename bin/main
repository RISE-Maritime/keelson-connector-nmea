#!/usr/bin/env python3

import zenoh
import logging
import warnings
import atexit
import json
import time
import keelson
from terminal_inputs import terminal_inputs
from datetime import datetime
from keelson.payloads.Primitives_pb2 import TimestampedBytes, TimestampedInt, TimestampedFloat
from keelson.payloads.foxglove.LocationFix_pb2 import LocationFix
import pynmea2
import sys
import pytz

session = None
args = None


if __name__ == "__main__":
    # Input arguments and configurations
    args = terminal_inputs()
    # Setup logger
    logging.basicConfig(
        format="%(asctime)s %(levelname)s %(name)s %(message)s", level=args.log_level
    )
    logging.captureWarnings(True)
    warnings.filterwarnings("once")

    ## Construct session
    logging.info("Opening Zenoh session...")
    zenoh.init_log_from_env_or("error")

    conf = zenoh.Config()
    if args.connect is not None:
        conf.insert_json5(zenoh.config.CONNECT_KEY, json.dumps(args.connect))
    with zenoh.open(conf) as session:
        logging.info("Zenoh session opened.")

        def _on_exit():
            session.close()

        atexit.register(_on_exit)

        #################################################
        # Setting up PUBLISHER

        # RAW NMEA publisher
        key_exp_pub_raw = keelson.construct_pubsub_key(
            base_path=args.realm,
            entity_id=args.entity_id,
            subject="raw",  
            source_id=args.source_id + "/nmea",
        )
        pub_raw = session.declare_publisher(
            key_exp_pub_raw, congestion_control=zenoh.CongestionControl.DROP
        )
        logging.info(f"Created publisher: {key_exp_pub_raw}")


        # Location Fix
        key_exp_pub_location_fix = keelson.construct_pubsub_key(
            base_path=args.realm,
            entity_id=args.entity_id,
            subject="location_fix",  
            source_id=args.source_id,
        )
        pub_location_fix = session.declare_publisher(
            key_exp_pub_location_fix,
            priority=zenoh.Priority.INTERACTIVE_HIGH,
            congestion_control=zenoh.CongestionControl.DROP,
        )
        logging.info(f"Created publisher: {key_exp_pub_location_fix}")


        # Satellites used
        key_exp_pub_satelites_used = keelson.construct_pubsub_key(
            base_path=args.realm,
            entity_id=args.entity_id,
            subject="location_fix_satellites_used", 
            source_id=args.source_id,
        )
        pub_satelites_used= session.declare_publisher(
            key_exp_pub_satelites_used,
            priority=zenoh.Priority.INTERACTIVE_HIGH,
            congestion_control=zenoh.CongestionControl.DROP,
        )
        logging.info(f"Created publisher: {key_exp_pub_satelites_used}")


        # Location Fix HADOP
        key_exp_pub_hadop = keelson.construct_pubsub_key(
            base_path=args.realm,
            entity_id=args.entity_id,
            subject="location_fix_hdop",  
            source_id=args.source_id,
        )
        pub_hadop = session.declare_publisher(
            key_exp_pub_hadop,
            priority=zenoh.Priority.INTERACTIVE_HIGH,
            congestion_control=zenoh.CongestionControl.DROP,
        )
        logging.info(f"Created publisher: {key_exp_pub_hadop}")



        try:
            for line in sys.stdin.buffer:
    
                ingress_timestamp = time.time_ns()

                if any(topic in args.publish for topic in ("raw", "all")):
                    logging.debug("Publish RAW message...")
                    payload = TimestampedBytes()
                    payload.timestamp.FromNanoseconds(ingress_timestamp)
                    payload.value = line
                    serialized_payload = payload.SerializeToString()
                    envelope = keelson.enclose(serialized_payload)
                    pub_raw.put(envelope)
                    logging.debug(f"...published on {key_exp_pub_raw}")



                logging.debug("Parsing NMEA message...")

                # Parsing NMEA data
                try:
                    nmea_sentence = line.decode("utf-8")

                    # logging.debug(f"Received NMEA utf-8: {nmea_sentence}")

                    if nmea_sentence.startswith("$GPGGA") and ("GNGNS" in args.publish or "all" in args.publish):
                        logging.debug( f"NMEA GNGNS: {nmea_sentence}" )
                        nmea_data = pynmea2.parse(nmea_sentence)

                        # Create a LocationFix payload
                        payload_location = LocationFix()
                        
                        # Timestamp
                        nmea_msg_timestamp = nmea_data.timestamp
                        nmea_msg_timestamp_dt = datetime.combine(datetime.today(), nmea_msg_timestamp, tzinfo=pytz.utc)
                        logging.debug(f"Timestamp REC: {nmea_msg_timestamp_dt}")
                        payload_location.timestamp.FromDatetime(nmea_msg_timestamp_dt)

                        # Latitude
                        if nmea_data.lat_dir == "S":
                            payload_location.latitude = float(-nmea_data.latitude)
                        else:
                            payload_location.latitude = float(nmea_data.latitude)
                        # Longitude
                        if nmea_data.lon_dir == "W":
                            payload_location.longitude = float(-nmea_data.longitude)
                        else:
                            payload_location.longitude = float(nmea_data.longitude)

                        # Altitude
                        payload_location.altitude = float(nmea_data.altitude)

                        serialized_payload = payload_location.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        pub_location_fix.put(envelope)
                        logging.debug(f"...published on {key_exp_pub_location_fix}")

                        # Satellites used
                        payload_sat_used = TimestampedInt()
                        payload_sat_used.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_sat_used.value = int(nmea_data.num_sats)
                        serialized_payload = payload_sat_used.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        pub_satelites_used.put(envelope)
                        logging.debug(f"...published on {key_exp_pub_satelites_used}")

                        # HDOP
                        payload_hdop = TimestampedFloat()
                        payload_hdop.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_hdop.value = float(nmea_data.hdop)
                        serialized_payload = payload_hdop.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        pub_hadop.put(envelope)
                        logging.debug(f"...published on {key_exp_pub_hadop}")
                    
                        # Create a LocationFix payload
                        payload_location = LocationFix()
                        
                        # Timestamp
                        nmea_msg_timestamp = nmea_data.timestamp
                        nmea_msg_timestamp_dt = datetime.combine(datetime.today(), nmea_msg_timestamp, tzinfo=pytz.utc)
                        logging.debug(f"Timestamp REC: {nmea_msg_timestamp_dt}")
                        payload_location.timestamp.FromDatetime(nmea_msg_timestamp_dt)

                        # Latitude
                        if nmea_data.lat_dir == "S":
                            payload_location.latitude = float(-nmea_data.latitude)
                        else:
                            payload_location.latitude = float(nmea_data.latitude)
                        # Longitude
                        if nmea_data.lon_dir == "W":
                            payload_location.longitude = float(-nmea_data.longitude)
                        else:
                            payload_location.longitude = float(nmea_data.longitude)

                        # Altitude
                        payload_location.altitude = float(nmea_data.altitude)

                        serialized_payload = payload_location.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        pub_location_fix.put(envelope)
                        logging.debug(f"...published on {key_exp_pub_location_fix}")


                    
                    # Global Positioning System Fix Data
                    # Example NMEA sentence: 
                    # $GPGGA,074641.00,5726.151284,N,01201.950160,E,1,09,0.6,20.6,M,39.0,M,,*59
                    # -------------------------------------------------
                    # Field                | Value         | Meaning
                    # -------------------------------------------------
                    # Sentence type        | $GPGGA        | Global Positioning System Fix Data
                    # Time (UTC)           | 074641.00     | 07:46:41.00 UTC
                    # Latitude             | 5726.151284   | 57 degrees 26.151284 minutes North
                    # N/S Indicator        | N             | North
                    # Longitude            | 01201.950160  | 12 degrees 1.950160 minutes East
                    # E/W Indicator        | E             | East
                    # Fix quality          | 1             | GPS fix (0 = invalid, 1 = GPS, 2 = DGPS, etc.)
                    # Number of satellites | 09            | 9 satellites used
                    # HDOP                 | 0.6           | Horizontal Dilution of Precision
                    # Altitude             | 20.6          | 20.6 meters
                    # Altitude units       | M             | Meters
                    # Geoid separation     | 39.0          | 39.0 meters
                    # Geoid separation units | M           | Meters
                    # Age of diff. GPS data | (empty)      | No differential correction info
                    # Diff. ref. station ID | (empty)      | No station ID
                    # Checksum             | *59           | Used to verify data integrity

                    if nmea_sentence.startswith("$GPGGA") and ("GPGGA" in args.publish or "all" in args.publish):
                        try:
                            # Parsing GPGGA sentence
                            logging.debug(f"Processing NMEA GPGGA: {nmea_sentence}")
                            nmea_data = pynmea2.parse(nmea_sentence)

                            # Create a LocationFix payload
                            payload_location = LocationFix()

                            # Timestamp
                            nmea_msg_timestamp_dt = datetime.combine(
                                datetime.today(), nmea_data.timestamp, tzinfo=pytz.utc
                            )
                            logging.debug(f"Extracted Timestamp: {nmea_msg_timestamp_dt}")
                            payload_location.timestamp.FromDatetime(nmea_msg_timestamp_dt)

                            # Latitude
                            payload_location.latitude = (
                                -float(nmea_data.latitude) if nmea_data.lat_dir == "S" else float(nmea_data.latitude)
                            )

                            # Longitude
                            payload_location.longitude = (
                                -float(nmea_data.longitude) if nmea_data.lon_dir == "W" else float(nmea_data.longitude)
                            )

                            # Altitude
                            payload_location.altitude = float(nmea_data.altitude)

                            # Serialize and publish LocationFix
                            serialized_payload = payload_location.SerializeToString()
                            envelope = keelson.enclose(serialized_payload)
                            pub_location_fix.put(envelope)
                            logging.debug(f"Published LocationFix on {key_exp_pub_location_fix}")

                            # Satellites used
                            payload_sat_used = TimestampedInt()
                            payload_sat_used.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                            payload_sat_used.value = int(nmea_data.num_sats)
                            serialized_payload = payload_sat_used.SerializeToString()
                            envelope = keelson.enclose(serialized_payload)
                            pub_satelites_used.put(envelope)
                            logging.debug(f"Published Satellites Used on {key_exp_pub_satelites_used}")

                            # HDOP
                            payload_hdop = TimestampedFloat()
                            payload_hdop.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                            payload_hdop.value = float(nmea_data.horizontal_dil)
                            serialized_payload = payload_hdop.SerializeToString()
                            envelope = keelson.enclose(serialized_payload)
                            pub_hadop.put(envelope)
                            logging.debug(f"Published HDOP on {key_exp_pub_hadop}")

                        except Exception as e:
                            logging.error(f"Error processing GPGGA sentence: {e}")
                    else:
                        logging.debug(f"Unrecognized NMEA sentence: {nmea_sentence}")



               
                except Exception as e:
                    logging.error(f"Error parsing NMEA data: {e}")
                    logging.debug( f"NMEA GNGNS: {nmea_sentence}" )
                    nmea_data = pynmea2.parse(nmea_sentence)


 
        except KeyboardInterrupt:
            logging.info("Closing down on user request!")
            logging.debug("Done! Good bye :)")
        except Exception as e:
            logging.error(f"Error: {e}")

    logging.info("Zenoh session closed.")
            
