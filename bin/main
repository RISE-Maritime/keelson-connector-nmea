#!/usr/bin/env python3

import zenoh
import logging
import warnings
import atexit
import json
import time
import keelson
from terminal_inputs import terminal_inputs
from nmea_utils import extract_rot_value
from datetime import datetime
from keelson.payloads.Primitives_pb2 import TimestampedBytes, TimestampedInt, TimestampedFloat, TimestampedString, TimestampedTimestamp
from keelson.payloads.foxglove.LocationFix_pb2 import LocationFix
import pynmea2
import sys
import pytz

session = None
args = None
gpgsv_buffer = []

if __name__ == "__main__":
    # Input arguments and configurations
    args = terminal_inputs()
    # Setup logger
    logging.basicConfig(
        format="%(asctime)s %(levelname)s %(name)s :%(lineno)d %(message)s", level=args.log_level
    )
    logging.captureWarnings(True)
    warnings.filterwarnings("once")

    ## Construct session
    logging.info("Opening Zenoh session...")
    zenoh.init_log_from_env_or("error")

    conf = zenoh.Config()
    if args.connect is not None:
        conf.insert_json5(zenoh.config.CONNECT_KEY, json.dumps(args.connect))
    
    with zenoh.open(conf) as session:
        logging.info("Zenoh session opened.")

        # def _on_exit():
        #     session.close()

        # atexit.register(_on_exit)

        #################################################
        # Setting up PUBLISHER

        # RAW NMEA publisher
        key_exp_pub_raw = keelson.construct_pubsub_key(
            base_path=args.realm,
            entity_id=args.entity_id,
            subject="raw",  
            source_id=args.source_id + "/nmea",
        )
        pub_raw = session.declare_publisher(
            key_exp_pub_raw, congestion_control=zenoh.CongestionControl.DROP
        )
        logging.info(f"Created publisher: {key_exp_pub_raw}")



        # SOCAT input stream
        #  for line in sys.stdin.buffer:
        while True:
            line = sys.stdin.buffer.readline()
            if not line:
                time.sleep(0.001)
                continue
            
            ingress_timestamp = time.time_ns()

            # Publish RAW message
            if any(topic in args.publish for topic in ("raw", "all")):
                logging.debug("Publish RAW message...")
                payload = TimestampedBytes()
                payload.timestamp.FromNanoseconds(ingress_timestamp)
                payload.value = line
                serialized_payload = payload.SerializeToString()
                envelope = keelson.enclose(serialized_payload)
                pub_raw.put(envelope)
                logging.debug(f"...published on {key_exp_pub_raw}")


            try:
                nmea_sentence = line.decode("utf-8").strip()
                logging.debug(f"Decoding NMEA message: {nmea_sentence}")
                
                # Clean up corrupted NMEA sentences by extracting valid NMEA part
                # Look for the last occurrence of $ which should be the start of a valid NMEA sentence
                dollar_index = nmea_sentence.rfind('$')
                if dollar_index > 0:
                    # Extract the NMEA sentence starting from the last $
                    cleaned_sentence = nmea_sentence[dollar_index:].strip()
                    logging.debug(f"Cleaned corrupted sentence: {nmea_sentence} -> {cleaned_sentence}")
                    nmea_sentence = cleaned_sentence
                elif not nmea_sentence.startswith('$'):
                    # Skip sentences that don't start with $ after cleaning
                    logging.debug(f"Skipping non-NMEA sentence: {nmea_sentence}")
                    continue

                # Global Navigation Satellite System Fix Data
                # Example NMEA sentence:
                # $GNGNS,074641.00,5726.151284,N,01201.950160,E,1,09,0.6,20.6,M,39.0,M,,*59
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # Sentence type        | $GNGNS        | Global Navigation Satellite System Fix Data
                # Time (UTC)           | 074641.00     | 07:46:41.00 UTC
                # Latitude             | 5726.151284   | 57 degrees 26.151284 minutes North
                # N/S Indicator        | N             | North
                # Longitude            | 01201.950160  | 12 degrees 1.950160 minutes East
                # E/W Indicator        | E             | East
                # Fix quality          | 1             | GPS fix (0 = invalid, 1 = GPS, 2 = DGPS, etc.)
                # Number of satellites | 09            | 9 satellites used
                # HDOP                 | 0.6           | Horizontal Dilution of Precision
                # Altitude             | 20.6          | 20.6 meters
                # Altitude units       | M             | Meters
                # Geoid separation     | 39.0          | 39.0 meters
                # Geoid separation units | M           | Meters
                # Age of diff. GPS data | (empty)      | No differential correction info
                # Diff. ref. station ID | (empty)      | No station ID
                # Checksum             | *59           | Used to verify data integrity

                if (nmea_sentence.startswith("$GNGNS") and ("GNGNS" in args.publish or "all" in args.publish)):
                    logging.debug( f"NMEA GNGNS: {nmea_sentence}" )
                    nmea_data = pynmea2.parse(nmea_sentence)

                    # Create a LocationFix payload
                    payload_location = LocationFix()
                    
                    # Timestamp
                    nmea_msg_timestamp = nmea_data.timestamp
                    nmea_msg_timestamp_dt = datetime.combine(datetime.today(), nmea_msg_timestamp, tzinfo=pytz.utc)
                    logging.debug(f"Timestamp REC: {nmea_msg_timestamp_dt}")
                    payload_location.timestamp.FromDatetime(nmea_msg_timestamp_dt)

                    # Latitude
                    if nmea_data.lat_dir == "S":
                        payload_location.latitude = float(-nmea_data.latitude)
                    else:
                        payload_location.latitude = float(nmea_data.latitude)
                    # Longitude
                    if nmea_data.lon_dir == "W":
                        payload_location.longitude = float(-nmea_data.longitude)
                    else:
                        payload_location.longitude = float(nmea_data.longitude)

                    # Altitude
                    payload_location.altitude = float(nmea_data.altitude)

                    serialized_payload = payload_location.SerializeToString()
                    envelope = keelson.enclose(serialized_payload)
                    key_exp_pub_location_fix_gngns = keelson.construct_pubsub_key(
                        base_path=args.realm,
                        entity_id=args.entity_id,
                        subject="location_fix", 
                        source_id=args.source_id + "/nmea/GNGNS",
                    )
                    session.put(
                        key_expr=key_exp_pub_location_fix_gngns,
                        payload=envelope,
                        priority=zenoh.Priority.INTERACTIVE_HIGH,
                        congestion_control=zenoh.CongestionControl.DROP,
                    )
                    logging.debug(f"...published on {key_exp_pub_location_fix_gngns}")

                    # Satellites used
                    payload_sat_used = TimestampedInt()
                    payload_sat_used.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                    payload_sat_used.value = int(nmea_data.num_sats)
                    serialized_payload = payload_sat_used.SerializeToString()
                    envelope = keelson.enclose(serialized_payload)
                    key_exp_pub_satelites_used = keelson.construct_pubsub_key(
                        base_path=args.realm,
                        entity_id=args.entity_id,
                        subject="location_fix_satellites_used", 
                        source_id=args.source_id + "/nmea/GNGNS",
                    )
                    session.put(
                        key_expr=key_exp_pub_satelites_used,
                        payload=envelope,
                        priority=zenoh.Priority.INTERACTIVE_HIGH,
                        congestion_control=zenoh.CongestionControl.DROP,
                    )
                    logging.debug(f"...published on {key_exp_pub_satelites_used}")

                    # HDOP
                    payload_hdop = TimestampedFloat()
                    payload_hdop.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                    payload_hdop.value = float(nmea_data.hdop)
                    serialized_payload = payload_hdop.SerializeToString()
                    envelope = keelson.enclose(serialized_payload)
                    key_exp_pub_hadop = keelson.construct_pubsub_key(
                        base_path=args.realm,
                        entity_id=args.entity_id,
                        subject="location_fix_hdop",
                        source_id=args.source_id + "/nmea/GNGNS",
                    )
                    session.put(
                        key_expr=key_exp_pub_hadop,
                        payload=envelope,
                        priority=zenoh.Priority.INTERACTIVE_HIGH,
                        congestion_control=zenoh.CongestionControl.DROP,
                    )
                    logging.debug(f"...published on {key_exp_pub_hadop}")

                

                # Global Positioning System Fix Data
                # Example NMEA sentence: 
                # $GPGGA,074641.00,5726.151284,N,01201.950160,E,1,09,0.6,20.6,M,39.0,M,,*59
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # Sentence type        | $GPGGA        | Global Positioning System Fix Data
                # Time (UTC)           | 074641.00     | 07:46:41.00 UTC
                # Latitude             | 5726.151284   | 57 degrees 26.151284 minutes North
                # N/S Indicator        | N             | North
                # Longitude            | 01201.950160  | 12 degrees 1.950160 minutes East
                # E/W Indicator        | E             | East
                # Fix quality          | 1             | GPS fix (0 = invalid, 1 = GPS, 2 = DGPS, etc.)
                # Number of satellites | 09            | 9 satellites used
                # HDOP                 | 0.6           | Horizontal Dilution of Precision
                # Altitude             | 20.6          | 20.6 meters
                # Altitude units       | M             | Meters
                # Geoid separation     | 39.0          | 39.0 meters
                # Geoid separation units | M           | Meters
                # Age of diff. GPS data | (empty)      | No differential correction info
                # Diff. ref. station ID | (empty)      | No station ID
                # Checksum             | *59           | Used to verify data integrity

                elif ((nmea_sentence.startswith("$GPGGA") or nmea_sentence.startswith("$GNGGA")) and ("all" in args.publish or any(tag in args.publish for tag in ("GPGGA", "GNGGA")))):

                    # Support both classic GPS ($GPGGA) and multi-GNSS ($GNGGA) variants
                    sentence_type = nmea_sentence[1:6]  # e.g. GPGGA or GNGGA
                    logging.debug(f"Processing NMEA {sentence_type}: {nmea_sentence}")
                    try:
                        nmea_data = pynmea2.parse(nmea_sentence)
                    except Exception as e:
                        logging.warning(f"Failed to parse {sentence_type} sentence: {e}")
                        logging.debug(f"Raw sentence: {nmea_sentence}")
                        nmea_data = None

                    if nmea_data is not None and getattr(nmea_data, 'timestamp', None) is not None:
                        # Create a LocationFix payload
                        payload_location = LocationFix()

                        # Timestamp (no date in GGA -> combine with today, still UTC)
                        nmea_msg_timestamp_dt = datetime.combine(
                            datetime.today(), nmea_data.timestamp, tzinfo=pytz.utc
                        )
                        payload_location.timestamp.FromDatetime(nmea_msg_timestamp_dt)

                        # Latitude
                        if getattr(nmea_data, 'latitude', None) not in (None, ''):
                            try:
                                lat_val = float(nmea_data.latitude)
                                payload_location.latitude = (
                                    -lat_val if nmea_data.lat_dir == "S" else lat_val
                                )
                            except (ValueError, TypeError):
                                logging.debug(f"Invalid latitude value in {sentence_type}")

                        # Longitude
                        if getattr(nmea_data, 'longitude', None) not in (None, ''):
                            try:
                                lon_val = float(nmea_data.longitude)
                                payload_location.longitude = (
                                    -lon_val if nmea_data.lon_dir == "W" else lon_val
                                )
                            except (ValueError, TypeError):
                                logging.debug(f"Invalid longitude value in {sentence_type}")

                        # Altitude
                        if getattr(nmea_data, 'altitude', None) not in (None, ''):
                            try:
                                payload_location.altitude = float(nmea_data.altitude)
                            except ValueError:
                                pass

                        # Serialize and publish LocationFix
                        serialized_payload = payload_location.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_location_fix_gga = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="location_fix",
                            source_id=args.source_id + f"/nmea/{sentence_type}",
                        )
                        session.put(
                            key_expr=key_exp_pub_location_fix_gga,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"Published LocationFix on {key_exp_pub_location_fix_gga}")

                        # Satellites used
                        if getattr(nmea_data, 'num_sats', None) not in (None, ''):
                            payload_sat_used = TimestampedInt()
                            payload_sat_used.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                            try:
                                sat_count = int(nmea_data.num_sats)
                                # Handle negative satellite counts (some receivers may output -1 to indicate unknown/invalid)
                                if sat_count >= 0:
                                    payload_sat_used.value = sat_count
                                    serialized_payload = payload_sat_used.SerializeToString()
                                    envelope = keelson.enclose(serialized_payload)
                                    key_exp_pub_sats_used = keelson.construct_pubsub_key(
                                        base_path=args.realm,
                                        entity_id=args.entity_id,
                                        subject="location_fix_satellites_used",
                                        source_id=args.source_id + f"/nmea/{sentence_type}",
                                    )
                                    session.put(
                                        key_expr=key_exp_pub_sats_used,
                                        payload=envelope,
                                        priority=zenoh.Priority.INTERACTIVE_HIGH,
                                        congestion_control=zenoh.CongestionControl.DROP,
                                    )
                                    logging.debug(f"Published Satellites Used on {key_exp_pub_sats_used}")
                                else:
                                    logging.debug(f"Skipping negative satellite count ({sat_count}) in {sentence_type}")
                            except ValueError:
                                logging.debug(f"Invalid satellites used value in {sentence_type}")

                        # HDOP (horizontal dilution)
                        # pynmea2 for GGA uses attribute 'horizontal_dil'
                        hdop_val = getattr(nmea_data, 'horizontal_dil', None)
                        if hdop_val not in (None, ''):
                            try:
                                payload_hdop = TimestampedFloat()
                                payload_hdop.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                                payload_hdop.value = float(hdop_val)
                                serialized_payload = payload_hdop.SerializeToString()
                                envelope = keelson.enclose(serialized_payload)
                                key_exp_pub_hdop = keelson.construct_pubsub_key(
                                    base_path=args.realm,
                                    entity_id=args.entity_id,
                                    subject="location_fix_hdop",
                                    source_id=args.source_id + f"/nmea/{sentence_type}",
                                )
                                session.put(
                                    key_expr=key_exp_pub_hdop,
                                    payload=envelope,
                                    priority=zenoh.Priority.INTERACTIVE_HIGH,
                                    congestion_control=zenoh.CongestionControl.DROP,
                                )
                                logging.debug(f"Published HDOP on {key_exp_pub_hdop}")
                            except ValueError:
                                logging.debug(f"Invalid HDOP value in {sentence_type}")

                # Global Navigation Satellite System Fix Data
                # Example NMEA sentence:
                # $GPGSA,A,2,05,16,18,20,23,26,27,29,31,,,,0.9,0.6,0.7*3B
                # $GNGSA,M,1,411,412,416,421,422,,,,,,,,1.15,0.69,0.92,4*38
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # 1                    | $GPGSA/$GNGSA | GNSS DOP and Active Satellites (GPS/GNSS source)
                # 2                    | A             | Auto selection of 2D/3D fix (vs. manual M)
                # 3                    | 2             | 2 = 2D fix (1 = no fix, 3 = 3D fix)
                # 4–15                 | 05,16,18,20,23,26,27,29,31 | PRNs (satellite IDs) used in solution (max 12 fields)
                # 16                   | 0.9           | PDOP (Position Dilution of Precision) – Overall fix quality
                # 17                   | 0.6           | HDOP (Horizontal Dilution of Precision) – Lateral accuracy
                # 18                   | 0.7           | VDOP (Vertical Dilution of Precision) – Altitude accuracy
                # Checksum             | *3B           | Used for sentence integrity check

                elif ((nmea_sentence.startswith("$GPGSA") or nmea_sentence.startswith("$GNGSA")) and ("all" in args.publish or any(tag in args.publish for tag in ("GPGSA", "GNGSA")))):
                    # Support both GPS ($GPGSA) and multi-GNSS ($GNGSA) variants
                    sentence_type = nmea_sentence[1:6]  # e.g. GPGSA or GNGSA
                    logging.debug(f"Processing NMEA {sentence_type}: {nmea_sentence}")
                    try:
                        nmea_data = pynmea2.parse(nmea_sentence)
                    except Exception as e:
                        logging.warning(f"Failed to parse {sentence_type} sentence: {e}")
                        logging.debug(f"Raw sentence: {nmea_sentence}")
                        nmea_data = None

                    if nmea_data is not None:
                        # HDOP (Horizontal Dilution of Precision)
                        hdop_val = getattr(nmea_data, 'hdop', None)
                        if hdop_val not in (None, ''):
                            try:
                                payload_hdop = TimestampedFloat()
                                payload_hdop.timestamp.FromNanoseconds(ingress_timestamp)
                                payload_hdop.value = float(hdop_val)
                                serialized_payload = payload_hdop.SerializeToString()
                                envelope = keelson.enclose(serialized_payload)
                                key_exp_pub_hdop = keelson.construct_pubsub_key(
                                    base_path=args.realm,
                                    entity_id=args.entity_id,
                                    subject="location_fix_hdop",
                                    source_id=args.source_id + f"/nmea/{sentence_type}",
                                )
                                session.put(
                                    key_expr=key_exp_pub_hdop,
                                    payload=envelope,
                                    priority=zenoh.Priority.INTERACTIVE_HIGH,
                                    congestion_control=zenoh.CongestionControl.DROP,
                                )
                                logging.debug(f"...published HDOP on {key_exp_pub_hdop}")
                            except ValueError:
                                logging.debug(f"Invalid HDOP value in {sentence_type}")

                        # VDOP (Vertical Dilution of Precision)
                        vdop_val = getattr(nmea_data, 'vdop', None)
                        if vdop_val not in (None, ''):
                            try:
                                payload_vdop = TimestampedFloat()
                                payload_vdop.timestamp.FromNanoseconds(ingress_timestamp)
                                payload_vdop.value = float(vdop_val)
                                serialized_payload = payload_vdop.SerializeToString()
                                envelope = keelson.enclose(serialized_payload)
                                key_exp_pub_vdop = keelson.construct_pubsub_key(
                                    base_path=args.realm,
                                    entity_id=args.entity_id,
                                    subject="location_fix_vdop",
                                    source_id=args.source_id + f"/nmea/{sentence_type}",
                                )
                                session.put(
                                    key_expr=key_exp_pub_vdop,
                                    payload=envelope,
                                    priority=zenoh.Priority.INTERACTIVE_HIGH,
                                    congestion_control=zenoh.CongestionControl.DROP,
                                )
                                logging.debug(f"...published VDOP on {key_exp_pub_vdop}")
                            except ValueError:
                                logging.debug(f"Invalid VDOP value in {sentence_type}")

                        # PDOP (Position Dilution of Precision)
                        pdop_val = getattr(nmea_data, 'pdop', None)
                        if pdop_val not in (None, ''):
                            try:
                                payload_pdop = TimestampedFloat()
                                payload_pdop.timestamp.FromNanoseconds(ingress_timestamp)
                                payload_pdop.value = float(pdop_val)
                                serialized_payload = payload_pdop.SerializeToString()
                                envelope = keelson.enclose(serialized_payload)
                                key_exp_pub_pdop = keelson.construct_pubsub_key(
                                    base_path=args.realm,
                                    entity_id=args.entity_id,
                                    subject="location_fix_pdop",
                                    source_id=args.source_id + f"/nmea/{sentence_type}",
                                )
                                session.put(
                                    key_expr=key_exp_pub_pdop,
                                    payload=envelope,
                                    priority=zenoh.Priority.INTERACTIVE_HIGH,
                                    congestion_control=zenoh.CongestionControl.DROP,
                                )
                                logging.debug(f"...published PDOP on {key_exp_pub_pdop}")
                            except ValueError:
                                logging.debug(f"Invalid PDOP value in {sentence_type}")

            
                # Course over ground and Ground speed
                # Example NMEA sentence:
                # $GPVTG,206.4,T,205.9,M,0.0,N,0.0,K,A*2D
                # $GNVTG,098.56,T,098.56,M,0.05,N,0.10,K,D*3C
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # 1                    | $GPVTG/$GNVTG | Course over ground and Ground speed (GPS/GNSS)
                # 2                    | 206.4         | Course in degrees (T = True, M = Magnetic)
                # 3                    | T             | True
                # 4                    | 205.9         | Magnetic
                # 5                    | M             | Magnetic
                # 6                    | 0.0           | Speed in knots
                # 7                    | N             | Knots
                # 8                    | 0.0           | Speed in kilometers per hour
                # 9                    | K             | Kilometers per hour
                # 10                   | A             | Status (A = Active, V = Void, D = Differential)  
                # 11                   | *2D           | Checksum

                elif ((nmea_sentence.startswith("$GPVTG") or nmea_sentence.startswith("$GNVTG")) and ("all" in args.publish or any(tag in args.publish for tag in ("GPVTG", "GNVTG")))):
                    # Support both GPS ($GPVTG) and multi-GNSS ($GNVTG) variants
                    sentence_type = nmea_sentence[1:6]  # e.g. GPVTG or GNVTG
                    logging.debug(f"Processing NMEA {sentence_type}: {nmea_sentence}")
                    try:
                        nmea_data = pynmea2.parse(nmea_sentence)
                    except Exception as e:
                        logging.warning(f"Failed to parse {sentence_type} sentence: {e}")
                        nmea_data = None
                    
                    if nmea_data is not None:
                        # Course over ground
                        true_track_val = getattr(nmea_data, 'true_track', None)
                        if true_track_val not in (None, ''):
                            try:
                                payload_course = TimestampedFloat()
                                payload_course.timestamp.FromNanoseconds(ingress_timestamp)
                                payload_course.value = float(true_track_val)
                                serialized_payload = payload_course.SerializeToString()
                                envelope = keelson.enclose(serialized_payload)
                                key_exp_pub_course = keelson.construct_pubsub_key(
                                    base_path=args.realm,
                                    entity_id=args.entity_id,
                                    subject="course_over_ground_deg",  
                                    source_id=args.source_id + f"/nmea/{sentence_type}",
                                )
                                session.put(
                                    key_expr=key_exp_pub_course,
                                    payload=envelope,
                                    priority=zenoh.Priority.INTERACTIVE_HIGH,
                                    congestion_control=zenoh.CongestionControl.DROP,
                                )
                                logging.debug(f"...published course on {key_exp_pub_course}")
                            except ValueError:
                                logging.debug(f"Invalid course value in {sentence_type}")
                        
                        # Ground speed
                        speed_val = getattr(nmea_data, 'spd_over_grnd_kts', None)
                        if speed_val not in (None, ''):
                            try:
                                payload_speed = TimestampedFloat()
                                payload_speed.timestamp.FromNanoseconds(ingress_timestamp)
                                payload_speed.value = float(speed_val)
                                serialized_payload = payload_speed.SerializeToString()
                                envelope = keelson.enclose(serialized_payload)
                                key_exp_pub_speed = keelson.construct_pubsub_key(
                                    base_path=args.realm,
                                    entity_id=args.entity_id,
                                    subject="speed_over_ground_knots",
                                    source_id=args.source_id + f"/nmea/{sentence_type}",
                                )
                                session.put(
                                    key_expr=key_exp_pub_speed,
                                    payload=envelope,
                                    priority=zenoh.Priority.INTERACTIVE_HIGH,
                                    congestion_control=zenoh.CongestionControl.DROP,
                                )
                                logging.debug(f"...published speed on {key_exp_pub_speed}")
                            except ValueError:
                                logging.debug(f"Invalid speed value in {sentence_type}")

                # Recommended Minimum Specific GNSS Data
                # Example NMEA sentence:
                # $GPRMC,090134.00,A,5726.151930,N,01201.950809,E,0.0,256.8,060525,0.5,E,A*34
                # $GNRMC,071259.60,A,5726.1565762,N,01201.9609842,E,0.03,102.33,060925,,W,D,V*66
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # 1                    | $GPRMC/$GNRMC | Recommended Minimum Specific GNSS Data (GPS/GNSS)
                # 2                    | 090134.00     | UTC time: 09:01:34.00
                # 3                    | A             | Status: A = Active (valid fix)
                # 4                    | 5726.151930   | Latitude: 57 degrees 26.151930 minutes North
                # 5                    | N             | North/South Indicator: North
                # 6                    | 01201.950809  | Longitude: 12 degrees 1.950809 minutes East
                # 7                    | E             | East/West Indicator: East
                # 8                    | 0.0           | Speed over ground: 0.0 knots
                # 9                    | 256.8         | Track angle: 256.8 degrees (degrees True)
                # 10                   | 060525        | Date: 06 May 2025
                # 11                   | 0.5           | Magnetic variation: 0.5 degrees
                # 12                   | E             | Magnetic variation direction: East
                # 13                   | A             | Mode: A = Autonomous GPS fix
                # Checksum             | *34           | Verifies data integrity

                elif ((nmea_sentence.startswith("$GPRMC") or nmea_sentence.startswith("$GNRMC")) and ("all" in args.publish or any(tag in args.publish for tag in ("GPRMC", "GNRMC")))):
                    # Support both GPS ($GPRMC) and multi-GNSS ($GNRMC) variants
                    sentence_type = nmea_sentence[1:6]  # e.g. GPRMC or GNRMC
                    logging.debug(f"Processing NMEA {sentence_type}: {nmea_sentence}")
                    try:
                        nmea_data = pynmea2.parse(nmea_sentence)
                    except Exception as e:
                        logging.warning(f"Failed to parse {sentence_type} sentence: {e}")
                        nmea_data = None

                    if nmea_data is not None and getattr(nmea_data, 'timestamp', None) is not None:
                        # Location fix
                        payload_location = LocationFix()
                        
                        # Timestamp
                        nmea_msg_timestamp_dt = datetime.combine(datetime.today(), nmea_data.timestamp, tzinfo=pytz.utc)
                        payload_location.timestamp.FromDatetime(nmea_msg_timestamp_dt)

                        # Latitude
                        if getattr(nmea_data, 'latitude', None) not in (None, ''):
                            try:
                                lat_val = float(nmea_data.latitude)
                                payload_location.latitude = -lat_val if nmea_data.lat_dir == "S" else lat_val
                            except ValueError:
                                logging.debug(f"Invalid latitude in {sentence_type}")
                        
                        # Longitude
                        if getattr(nmea_data, 'longitude', None) not in (None, ''):
                            try:
                                lon_val = float(nmea_data.longitude)
                                payload_location.longitude = -lon_val if nmea_data.lon_dir == "W" else lon_val
                            except ValueError:
                                logging.debug(f"Invalid longitude in {sentence_type}")

                        # Publish location fix
                        serialized_payload = payload_location.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_location_fix_rmc = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="location_fix", 
                            source_id=args.source_id + f"/nmea/{sentence_type}",
                        )
                        session.put(
                            key_expr=key_exp_pub_location_fix_rmc,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published location on {key_exp_pub_location_fix_rmc}")

                        # Course over ground
                        course_val = getattr(nmea_data, 'true_course', None)
                        if course_val not in (None, ''):
                            try:
                                payload_course = TimestampedFloat()
                                payload_course.timestamp.FromNanoseconds(ingress_timestamp)
                                payload_course.value = float(course_val)
                                serialized_payload = payload_course.SerializeToString()
                                envelope = keelson.enclose(serialized_payload)
                                key_exp_pub_course = keelson.construct_pubsub_key(
                                    base_path=args.realm,
                                    entity_id=args.entity_id,
                                    subject="course_over_ground_deg",  
                                    source_id=args.source_id + f"/nmea/{sentence_type}",
                                )
                                session.put(
                                    key_expr=key_exp_pub_course,
                                    payload=envelope,
                                    priority=zenoh.Priority.INTERACTIVE_HIGH,
                                    congestion_control=zenoh.CongestionControl.DROP,
                                )
                                logging.debug(f"...published course on {key_exp_pub_course}")
                            except ValueError:
                                logging.debug(f"Invalid course value in {sentence_type}")

                        # Ground speed
                        speed_val = getattr(nmea_data, 'spd_over_grnd', None)
                        if speed_val not in (None, ''):
                            try:
                                payload_speed = TimestampedFloat()
                                payload_speed.timestamp.FromNanoseconds(ingress_timestamp)
                                payload_speed.value = float(speed_val)
                                serialized_payload = payload_speed.SerializeToString()
                                envelope = keelson.enclose(serialized_payload)
                                key_exp_pub_speed = keelson.construct_pubsub_key(
                                    base_path=args.realm,
                                    entity_id=args.entity_id,
                                    subject="speed_over_ground_knots",
                                    source_id=args.source_id + f"/nmea/{sentence_type}",
                                )
                                session.put(
                                    key_expr=key_exp_pub_speed,
                                    payload=envelope,
                                    priority=zenoh.Priority.INTERACTIVE_HIGH,
                                    congestion_control=zenoh.CongestionControl.DROP,
                                )
                                logging.debug(f"...published speed on {key_exp_pub_speed}")
                            except ValueError:
                                logging.debug(f"Invalid speed value in {sentence_type}")

                # Rate of Turn
                # Example NMEA sentence:
                # $GPROT,0.0,A*hh
                # 1                    | $GPROT        | Rate of Turn message
                # 2                    | 0.0           | Rate of turn in degrees per minute
                # 3                    | A             | Status (A = data valid)

                elif (nmea_sentence.startswith("$GPROT") or nmea_sentence.startswith("$GNROT")) and ("ROT" in args.publish or "all" in args.publish):
                    logging.debug(f"Processing NMEA ROT: {nmea_sentence}")
                    rot_numeric = extract_rot_value(nmea_sentence)
                    if rot_numeric is not None:

                        payload_rot = TimestampedFloat()
                        payload_rot.timestamp.FromNanoseconds(ingress_timestamp)
                        payload_rot.value = rot_numeric
                        serialized_payload = payload_rot.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_rot = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="yaw_rate_degps",
                            source_id=args.source_id + "/nmea/ROT",
                        )
                        session.put(
                            key_expr=key_exp_pub_rot,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published on {key_exp_pub_rot}")

                # GNGST - GPS/GNSS pseudorange error statistics
                # Example NMEA sentence:
                # $GNGST,104534.00,1.6,1.4,3.2,15.0,2.1,5.8,4.6*75
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # 1                    | $GNGST        | GPS/GNSS pseudorange error statistics
                # 2                    | 104534.00     | UTC time: 10:45:34.00
                # 3                    | 1.6           | RMS value of standard deviation of range inputs (meters)
                # 4                    | 1.4           | Standard deviation of semi-major axis of error ellipse (meters)
                # 5                    | 3.2           | Standard deviation of semi-minor axis of error ellipse (meters)
                # 6                    | 15.0          | Orientation of semi-major axis (degrees from true north)
                # 7                    | 2.1           | Standard deviation of latitude error (meters)
                # 8                    | 5.8           | Standard deviation of longitude error (meters)
                # 9                    | 4.6           | Standard deviation of altitude error (meters)
                # Checksum             | *75           | Used to verify data integrity

                elif (nmea_sentence.startswith("$GNGST") and ("GNGST" in args.publish or "all" in args.publish)):
                    logging.debug(f"Processing NMEA GNGST: {nmea_sentence}")
                    nmea_data = pynmea2.parse(nmea_sentence)

                    # Timestamp from GNGST message
                    if nmea_data.timestamp is not None:
                        nmea_msg_timestamp_dt = datetime.combine(datetime.today(), nmea_data.timestamp, tzinfo=pytz.utc)
                    else:
                        # Use ingress timestamp if no timestamp in GNGST message
                        nmea_msg_timestamp_dt = datetime.fromtimestamp(ingress_timestamp / 1e9, tz=pytz.utc)
                    
                    # RMS value of standard deviation of range inputs
                    if nmea_data.rms is not None:
                        payload_rms = TimestampedFloat()
                        payload_rms.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_rms.value = float(nmea_data.rms)
                        serialized_payload = payload_rms.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_rms = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="gnss_error_rms_meters",
                            source_id=args.source_id + "/nmea/GNGST",
                        )
                        session.put(
                            key_expr=key_exp_pub_rms,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published RMS on {key_exp_pub_rms}")

                    # Standard deviation of semi-major axis
                    if nmea_data.std_dev_major is not None:
                        payload_major = TimestampedFloat()
                        payload_major.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_major.value = float(nmea_data.std_dev_major)
                        serialized_payload = payload_major.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_major = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="gnss_error_semi_major_axis_meters",
                            source_id=args.source_id + "/nmea/GNGST",
                        )
                        session.put(
                            key_expr=key_exp_pub_major,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published semi-major axis on {key_exp_pub_major}")

                    # Standard deviation of semi-minor axis
                    if nmea_data.std_dev_minor is not None:
                        payload_minor = TimestampedFloat()
                        payload_minor.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_minor.value = float(nmea_data.std_dev_minor)
                        serialized_payload = payload_minor.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_minor = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="gnss_error_semi_minor_axis_meters",
                            source_id=args.source_id + "/nmea/GNGST",
                        )
                        session.put(
                            key_expr=key_exp_pub_minor,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published semi-minor axis on {key_exp_pub_minor}")

                    # Orientation of semi-major axis
                    if nmea_data.orientation is not None:
                        payload_orientation = TimestampedFloat()
                        payload_orientation.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_orientation.value = float(nmea_data.orientation)
                        serialized_payload = payload_orientation.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_orientation = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="gnss_error_orientation_degrees",
                            source_id=args.source_id + "/nmea/GNGST",
                        )
                        session.put(
                            key_expr=key_exp_pub_orientation,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published orientation on {key_exp_pub_orientation}")

                    # Standard deviation of latitude error
                    if nmea_data.std_dev_latitude is not None:
                        payload_lat_error = TimestampedFloat()
                        payload_lat_error.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_lat_error.value = float(nmea_data.std_dev_latitude)
                        serialized_payload = payload_lat_error.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_lat_error = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="gnss_error_latitude_meters",
                            source_id=args.source_id + "/nmea/GNGST",
                        )
                        session.put(
                            key_expr=key_exp_pub_lat_error,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published latitude error on {key_exp_pub_lat_error}")

                    # Standard deviation of longitude error
                    if nmea_data.std_dev_longitude is not None:
                        payload_lon_error = TimestampedFloat()
                        payload_lon_error.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_lon_error.value = float(nmea_data.std_dev_longitude)
                        serialized_payload = payload_lon_error.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_lon_error = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="gnss_error_longitude_meters",
                            source_id=args.source_id + "/nmea/GNGST",
                        )
                        session.put(
                            key_expr=key_exp_pub_lon_error,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published longitude error on {key_exp_pub_lon_error}")

                    # Standard deviation of altitude error
                    if nmea_data.std_dev_altitude is not None:
                        payload_alt_error = TimestampedFloat()
                        payload_alt_error.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_alt_error.value = float(nmea_data.std_dev_altitude)
                        serialized_payload = payload_alt_error.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_alt_error = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="gnss_error_altitude_meters",
                            source_id=args.source_id + "/nmea/GNGST",
                        )
                        session.put(
                            key_expr=key_exp_pub_alt_error,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published altitude error on {key_exp_pub_alt_error}")

                # GNZDA - Date and Time
                # Example NMEA sentence:
                # $GNZDA,104534.00,05,09,2025,00,00*76
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # 1                    | $GNZDA        | Date and Time message
                # 2                    | 104534.00     | UTC time: 10:45:34.00
                # 3                    | 05            | Day: 05
                # 4                    | 09            | Month: 09 (September)
                # 5                    | 2025          | Year: 2025
                # 6                    | 00            | Local zone description: 00 hours
                # 7                    | 00            | Local zone description: 00 minutes
                # Checksum             | *76           | Used to verify data integrity

                elif (nmea_sentence.startswith("$GNZDA") and ("GNZDA" in args.publish or "all" in args.publish)):
                    logging.debug(f"Processing NMEA GNZDA: {nmea_sentence}")
                    nmea_data = pynmea2.parse(nmea_sentence)

                    # Construct full datetime from GNZDA message (has complete date and time)
                    if all([nmea_data.day, nmea_data.month, nmea_data.year, nmea_data.timestamp]):
                        try:
                            full_datetime = datetime.combine(
                                datetime(int(nmea_data.year), int(nmea_data.month), int(nmea_data.day)),
                                nmea_data.timestamp,
                                tzinfo=pytz.utc
                            )
                            
                            # Publish complete datetime as timestamp
                            payload_datetime = TimestampedTimestamp()
                            payload_datetime.timestamp.FromDatetime(full_datetime)
                            payload_datetime.value.FromDatetime(full_datetime)
                            serialized_payload = payload_datetime.SerializeToString()
                            envelope = keelson.enclose(serialized_payload)
                            key_exp_pub_datetime = keelson.construct_pubsub_key(
                                base_path=args.realm,
                                entity_id=args.entity_id,
                                subject="timestamp",
                                source_id=args.source_id + "/nmea/GNZDA/utc_complete",
                            )
                            session.put(
                                key_expr=key_exp_pub_datetime,
                                payload=envelope,
                                priority=zenoh.Priority.INTERACTIVE_HIGH,
                                congestion_control=zenoh.CongestionControl.DROP,
                            )
                            logging.debug(f"...published datetime on {key_exp_pub_datetime}")
                                
                        except (ValueError, TypeError) as e:
                            logging.warning(f"Failed to construct datetime from GNZDA message: {e}")
                            logging.debug(f"GNZDA values - day: {nmea_data.day}, month: {nmea_data.month}, year: {nmea_data.year}, time: {nmea_data.timestamp}")

                # GNTHS - GNSS True Heading Sentence
                # Example NMEA sentence:
                # $GNTHS,337.05,V*0C
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # 1                    | $GNTHS        | GNSS True Heading Sentence
                # 2                    | 337.05        | True heading in degrees (0-359.99)
                # 3                    | V             | Status (A = valid, V = invalid)
                # Checksum             | *0C           | Used to verify data integrity

                elif (nmea_sentence.startswith("$GNTHS") and ("GNTHS" in args.publish or "all" in args.publish)):
                    logging.debug(f"Processing NMEA GNTHS: {nmea_sentence}")
                    try:
                        # Try pynmea2 first
                        nmea_data = pynmea2.parse(nmea_sentence)
                        heading_val = getattr(nmea_data, 'true_heading', None)
                        status_val = getattr(nmea_data, 'status', None)
                    except Exception as e:
                        # Fallback to manual parsing since pynmea2 may not support GNTHS
                        logging.debug(f"pynmea2 failed for GNTHS, using manual parsing: {e}")
                        try:
                            # Manual parsing: $GNTHS,heading,status*checksum
                            parts = nmea_sentence.split(',')
                            if len(parts) >= 3:
                                heading_val = parts[1] if parts[1] else None
                                status_part = parts[2].split('*')[0]  # Remove checksum
                                status_val = status_part if status_part else None
                            else:
                                heading_val = None
                                status_val = None
                        except Exception as parse_error:
                            logging.warning(f"Failed to manually parse GNTHS sentence: {parse_error}")
                            heading_val = None
                            status_val = None

                    # Only publish if we have a valid heading and status indicates valid data
                    if heading_val not in (None, '') and status_val == 'A':
                        try:
                            payload_heading = TimestampedFloat()
                            payload_heading.timestamp.FromNanoseconds(ingress_timestamp)
                            payload_heading.value = float(heading_val)
                            serialized_payload = payload_heading.SerializeToString()
                            envelope = keelson.enclose(serialized_payload)
                            key_exp_pub_heading = keelson.construct_pubsub_key(
                                base_path=args.realm,
                                entity_id=args.entity_id,
                                subject="heading_true_north_deg",
                                source_id=args.source_id + "/nmea/GNTHS",
                            )
                            session.put(
                                key_expr=key_exp_pub_heading,
                                payload=envelope,
                                priority=zenoh.Priority.INTERACTIVE_HIGH,
                                congestion_control=zenoh.CongestionControl.DROP,
                            )
                            logging.debug(f"...published true heading on {key_exp_pub_heading}")
                        except ValueError:
                            logging.debug("Invalid heading value in GNTHS")
                    elif status_val == 'V':
                        logging.debug("GNTHS heading marked as invalid (status=V), skipping")
                    else:
                        logging.debug("GNTHS heading value missing or empty")

                # PASHR - RT300 proprietary roll and pitch sentence
                # Example NMEA sentence:
                # $PASHR,104534.00,45.2,T,-2.5,3.8,0.5,0.1,0.1,0.2,1,0*33
                # -------------------------------------------------
                # Field                | Value         | Meaning
                # -------------------------------------------------
                # 1                    | $PASHR        | RT300 proprietary roll and pitch sentence
                # 2                    | 104534.00     | UTC time: 10:45:34.00
                # 3                    | 45.2          | Heading angle (degrees)
                # 4                    | T             | True heading flag (T/M for True/Magnetic)
                # 5                    | -2.5          | Roll angle (degrees, positive = port side down)
                # 6                    | 3.8           | Pitch angle (degrees, positive = bow up)
                # 7                    | 0.5           | Heave (meters, positive = up)
                # 8                    | 0.1           | Roll accuracy estimate (degrees, 1-sigma)
                # 9                    | 0.1           | Pitch accuracy estimate (degrees, 1-sigma)
                # 10                   | 0.2           | Heading accuracy estimate (degrees, 1-sigma)
                # 11                   | 1             | Aiding status (0=GPS only, 1=GPS+inertial)
                # 12                   | 0             | IMU status (0=good)
                # Checksum             | *33           | Used to verify data integrity

                elif (nmea_sentence.startswith("$PASHR") and ("PASHR" in args.publish or "all" in args.publish)):
                    logging.debug(f"Processing NMEA PASHR: {nmea_sentence}")
                    nmea_data = pynmea2.parse(nmea_sentence)

                    # Timestamp from PASHR message
                    if nmea_data.timestamp is not None:
                        nmea_msg_timestamp_dt = datetime.combine(datetime.today(), nmea_data.timestamp, tzinfo=pytz.utc)
                    else:
                        # Use ingress timestamp if no timestamp in PASHR message
                        nmea_msg_timestamp_dt = datetime.fromtimestamp(ingress_timestamp / 1e9, tz=pytz.utc)

                    # Heading angle
                    if nmea_data.true_heading is not None:
                        payload_heading = TimestampedFloat()
                        payload_heading.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_heading.value = float(nmea_data.true_heading)
                        serialized_payload = payload_heading.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        
                        # Use appropriate subject name based on true/magnetic heading (updated to match schema)
                        if nmea_data.is_true_heading == "T":
                            heading_subject = "heading_true_north_deg"
                            heading_type = "true north"
                        else:
                            heading_subject = "heading_magnetic_deg"
                            heading_type = "magnetic"
                            
                        key_exp_pub_heading = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject=heading_subject,
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_heading,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published {heading_type} heading on {key_exp_pub_heading}")

                    # Roll angle (updated to match schema)
                    if nmea_data.roll is not None:
                        payload_roll = TimestampedFloat()
                        payload_roll.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_roll.value = float(nmea_data.roll)
                        serialized_payload = payload_roll.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_roll = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="roll_deg",
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_roll,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published roll on {key_exp_pub_roll}")

                    # Pitch angle (updated to match schema)
                    if nmea_data.pitch is not None:
                        payload_pitch = TimestampedFloat()
                        payload_pitch.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_pitch.value = float(nmea_data.pitch)
                        serialized_payload = payload_pitch.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_pitch = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="pitch_deg",
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_pitch,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published pitch on {key_exp_pub_pitch}")

                    # Heave (updated to match schema)
                    if nmea_data.heave is not None:
                        payload_heave = TimestampedFloat()
                        payload_heave.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_heave.value = float(nmea_data.heave)
                        serialized_payload = payload_heave.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_heave = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="heave_m",
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_heave,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published heave on {key_exp_pub_heave}")

                    # Roll accuracy (suggested new subject following schema pattern)
                    if nmea_data.roll_accuracy is not None:
                        payload_roll_acc = TimestampedFloat()
                        payload_roll_acc.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_roll_acc.value = float(nmea_data.roll_accuracy)
                        serialized_payload = payload_roll_acc.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_roll_acc = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="roll_accuracy_deg",
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_roll_acc,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published roll accuracy on {key_exp_pub_roll_acc}")

                    # Pitch accuracy (suggested new subject following schema pattern)
                    if nmea_data.pitch_accuracy is not None:
                        payload_pitch_acc = TimestampedFloat()
                        payload_pitch_acc.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_pitch_acc.value = float(nmea_data.pitch_accuracy)
                        serialized_payload = payload_pitch_acc.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_pitch_acc = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="pitch_accuracy_deg",
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_pitch_acc,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published pitch accuracy on {key_exp_pub_pitch_acc}")

                    # Heading accuracy (suggested new subject following schema pattern)
                    if nmea_data.heading_accuracy is not None:
                        payload_heading_acc = TimestampedFloat()
                        payload_heading_acc.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_heading_acc.value = float(nmea_data.heading_accuracy)
                        serialized_payload = payload_heading_acc.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_heading_acc = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="heading_accuracy_deg",
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_heading_acc,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published heading accuracy on {key_exp_pub_heading_acc}")

                    # Aiding status (suggested new subject following schema pattern)
                    if nmea_data.aiding_status is not None:
                        payload_aiding = TimestampedInt()
                        payload_aiding.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_aiding.value = int(nmea_data.aiding_status)
                        serialized_payload = payload_aiding.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_aiding = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="gnss_aiding_status",
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_aiding,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published aiding status on {key_exp_pub_aiding}")

                    # IMU status (suggested new subject following schema pattern)
                    if nmea_data.imu_status is not None:
                        payload_imu = TimestampedInt()
                        payload_imu.timestamp.FromDatetime(nmea_msg_timestamp_dt)
                        payload_imu.value = int(nmea_data.imu_status)
                        serialized_payload = payload_imu.SerializeToString()
                        envelope = keelson.enclose(serialized_payload)
                        key_exp_pub_imu = keelson.construct_pubsub_key(
                            base_path=args.realm,
                            entity_id=args.entity_id,
                            subject="imu_system_status",
                            source_id=args.source_id + "/nmea/PASHR",
                        )
                        session.put(
                            key_expr=key_exp_pub_imu,
                            payload=envelope,
                            priority=zenoh.Priority.INTERACTIVE_HIGH,
                            congestion_control=zenoh.CongestionControl.DROP,
                        )
                        logging.debug(f"...published IMU status on {key_exp_pub_imu}")


                # GPGSV - GPS Satellites in View
                # GSV messages report information about satellites that the receiver can “see”, 
                # including PRN number, elevation, azimuth, and SNR. This sentence is sent once per second, 
                # and contains information about all satellites in view. The GSV sentence is usually sent 
                # in a series of three sentences.
                # Example NMEA sentence:
                # $GPGSV,3,1,12,05,27,049,51,16,53,285,47,18,70,140,52,20,05,023,37*72
                # $GPGSV,3,2,12,23,16,144,41,26,63,226,46,27,21,270,38,29,32,090,49*7A
                # $GPGSV,3,3,12,31,15,217,37,07,01,345,,09,00,317,,49,,,43*4E
                # Combine incoming GPGSV messages into a single output
                elif (nmea_sentence.startswith("$GPGSV") and ("GPGSV" in args.publish or "all" in args.publish)):
                    logging.debug(f"Processing NMEA GPGSV: {nmea_sentence}")
                    
                    # Function to combine GPGSV messages
                    def combine_gpgsv_messages(messages):
                        combined_data = {
                            "total_messages": 0,
                            "current_message": 0,
                            "satellites_in_view": 0,
                            "satellites": []
                        }
                        for msg in messages:
                            try:
                                parsed_msg = pynmea2.parse(msg)
                                raw_total = getattr(parsed_msg, 'num_messages', None)
                                if raw_total not in (None, ''):
                                    try:
                                        combined_data["total_messages"] = int(str(raw_total))
                                    except (TypeError, ValueError):
                                        pass
                                raw_current = getattr(parsed_msg, 'msg_num', None)
                                if raw_current not in (None, ''):
                                    try:
                                        combined_data["current_message"] = int(str(raw_current))
                                    except (TypeError, ValueError):
                                        pass
                                raw_in_view = getattr(parsed_msg, 'num_sv_in_view', None)
                                if raw_in_view not in (None, ''):
                                    try:
                                        combined_data["satellites_in_view"] = int(str(raw_in_view))
                                    except (TypeError, ValueError):
                                        pass
                                
                                for i in range(4):  # Each GPGSV message can contain up to 4 satellites
                                    prn = getattr(parsed_msg, f"sv_prn_num_{i+1}", None)
                                    elevation = getattr(parsed_msg, f"elevation_deg_{i+1}", None)
                                    azimuth = getattr(parsed_msg, f"azimuth_deg_{i+1}", None)
                                    snr = getattr(parsed_msg, f"snr_{i+1}", None)
                                    if prn:
                                        combined_data["satellites"].append({
                                            "prn": prn,
                                            "elevation": elevation,
                                            "azimuth": azimuth,
                                            "snr": snr
                                        })
                            except Exception as e:
                                logging.warning(f"Error parsing GPGSV message: {e}")
                        return combined_data

    
                    gpgsv_buffer.append(nmea_sentence)

                    # Check if all GPGSV messages have been received
                    try:
                        parsed_msg = pynmea2.parse(nmea_sentence)
                        raw_total = getattr(parsed_msg, 'num_messages', None)
                        try:
                            total_messages = int(str(raw_total)) if raw_total not in (None, '') else 0
                        except (TypeError, ValueError):
                            total_messages = 0
                        raw_current = getattr(parsed_msg, 'msg_num', None)
                        try:
                            current_message = int(str(raw_current)) if raw_current not in (None, '') else 0
                        except (TypeError, ValueError):
                            current_message = 0

                        if current_message == total_messages:
                            # Combine and process all messages
                            combined_data = combine_gpgsv_messages(gpgsv_buffer)
                            gpgsv_buffer = []  # Clear buffer after processing

                            # Serialize and publish combined GPGSV data
                            payload_gpgsv = TimestampedString()
                            payload_gpgsv.timestamp.FromNanoseconds(ingress_timestamp)
                            payload_gpgsv.value = json.dumps(combined_data).encode("utf-8")
                            serialized_payload = payload_gpgsv.SerializeToString()
                            envelope = keelson.enclose(serialized_payload)
                            key_exp_pub_gpgsv = keelson.construct_pubsub_key(
                                base_path=args.realm,
                                entity_id=args.entity_id,
                                subject="raw_json",
                                source_id=args.source_id + "/nmea/GPGSV",
                            )
                            session.put(
                                key_expr=key_exp_pub_gpgsv,
                                payload=envelope,
                                priority=zenoh.Priority.INTERACTIVE_HIGH,
                                congestion_control=zenoh.CongestionControl.DROP,
                            )
                            logging.debug(f"Published combined GPGSV data on {key_exp_pub_gpgsv}")

                    except Exception as e:
                        logging.warning(f"Error processing GPGSV message: {e}")

                else:
                    # Log detailed information about why this sentence wasn't recognized
                    sentence_prefix = nmea_sentence[:6] if len(nmea_sentence) >= 6 else nmea_sentence
                    logging.debug(f"Checking sentence {sentence_prefix} against publish filter: {args.publish}")
                    
                    # Check if it's a known sentence type but not in publish filter
                    known_prefixes = ["$GNGNS", "$GPGGA", "$GNGGA", "$GPGSA", "$GNGSA", "$GPVTG", "$GNVTG", 
                                     "$GPRMC", "$GNRMC", "$GPROT", "$GNROT", "$GNGST", "$GNZDA", "$GNTHS", "$PASHR", "$GPGSV"]
                    
                    if any(nmea_sentence.startswith(prefix) for prefix in known_prefixes):
                        logging.debug(f"Known NMEA sentence type {sentence_prefix} not in publish filter or failed conditions")
                    else:
                        logging.warning(f"Unrecognized NMEA sentence: {nmea_sentence}")

            except pynmea2.ChecksumError as e:
                logging.warning(f"Skipping NMEA line due to invalid checksum: {e}")
                logging.debug(f"NMEA: {nmea_sentence}")
                continue
            except Exception as e:
                logging.error(f"Error parsing NMEA data: {e}")
                logging.error( f"NMEA RAW: {nmea_sentence}" )
                continue

 

    logging.info("Zenoh session closed.")
    sys.exit(0)
